{
  "name": "hubbit",
  "version": "0.2.0",
  "description": "A filesystem-backed alternative to GitHub/GitLab: point a web server at a directory of collections and bare git repositories.",
  "bin": {
    "hubbit": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts serve example-root",
    "start": "node dist/index.js serve",
    "example": "bash scripts/create-example.sh example-root",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "aws4fetch": "^1.0.20",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.4",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
